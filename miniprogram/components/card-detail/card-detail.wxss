.mask { position: fixed; inset: 0; z-index: 100; background: rgba(5, 8, 16, .92); display: flex; align-items: center; justify-content: center; }
.modal { width: 88vw; max-height: 82vh; background: #17203a; border: 1rpx solid rgba(255,255,255,.09); border-radius: 24rpx; display: flex; flex-direction: column; overflow: hidden; }
.modal-head { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; border-bottom: 1rpx solid rgba(255,255,255,.09); }
.modal-title { color: #e8edf6; font-size: 30rpx; font-weight: 800; }
.close-btn { color: #9aa7bd; padding: 0 10rpx; }
.modal-body { padding: 24rpx; box-sizing: border-box; max-height: 66vh; }
.d-wrap { display: flex; gap: 24rpx; }
.d-img { width: 300rpx; border-radius: 14rpx; background: #1a2233; flex-shrink: 0; }
.d-info { flex: 1; color: #e8edf6; font-size: 24rpx; line-height: 1.6; }
.d-name { font-size: 28rpx; font-weight: 800; display: flex; align-items: center; flex-wrap: wrap; }
.d-sub { color: #9aa7bd; font-size: 21rpx; margin: 8rpx 0; }
.d-grid { display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; color: #c3cbda; margin: 8rpx 0; }
.d-effect { background: rgba(255,255,255,.05); border-radius: 12rpx; padding: 12rpx; margin: 8rpx 0; }
.d-attack { border-top: 1rpx dashed rgba(255,255,255,.12); padding: 10rpx 0; display: flex; flex-direction: column; }
.a-name { font-weight: 800; }
.a-text { color: #b6c0d2; font-size: 22rpx; }
.d-degrade { color: #f6a5c0; font-size: 21rpx; margin-top: 10rpx; }
.empty-tip { color: #9aa7bd; text-align: center; padding: 40rpx 0; }

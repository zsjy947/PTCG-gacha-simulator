.page { padding: 20rpx 24rpx 0; }
.set-pick { max-width: 480rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter-row { display: flex; gap: 14rpx; margin: 4rpx 0 16rpx; }
.search { flex: 1; background: var(--field); border: 1rpx solid var(--line); border-radius: 14rpx; padding: 12rpx 20rpx; font-size: 24rpx; color: var(--txt); }
.ph { color: var(--txt2); }
.count { font-size: 20rpx; color: var(--txt2); text-align: center; margin-bottom: 10rpx; }
.cl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.cl-card { border-radius: 16rpx; overflow: hidden; background: var(--card-bg); border: 1rpx solid var(--line); }
.cl-card image { width: 100%; height: 320rpx; display: block; background: var(--imgbg); }
.cl-name { display: flex; align-items: center; padding: 10rpx 12rpx; gap: 4rpx; }
.cl-n { font-size: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.page { padding: 20rpx 24rpx 0; }

/* 弹包选择 */
.set-picker { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; }
.sp-info { display: flex; flex-direction: column; gap: 6rpx; }
.sp-name { font-size: 30rpx; font-weight: 800; }
.sp-meta { font-size: 22rpx; color: var(--txt2); }
.sp-arrow { color: var(--txt2); }

/* 抽屉 */
.drawer-mask { position: fixed; inset: 0; z-index: 50; background: rgba(4, 7, 14, .72); display: flex; justify-content: flex-start; }
.drawer { width: 78vw; height: 100vh; background: var(--panel); backdrop-filter: blur(20px); display: flex; flex-direction: column; }
.drawer-head { display: flex; align-items: center; gap: 16rpx; padding: 28rpx 24rpx 16rpx; }
.drawer-search { flex: 1; background: var(--field); border: 1rpx solid var(--line); border-radius: 14rpx; padding: 14rpx 20rpx; font-size: 26rpx; color: var(--txt); }
.ph { color: var(--txt2); }
.close-btn { color: var(--txt2); padding: 10rpx; }
.drawer-body { flex: 1; padding: 0 16rpx 40rpx; box-sizing: border-box; }
.group-title { font-size: 22rpx; color: var(--accent); margin: 24rpx 8rpx 10rpx; }
.set-item { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 16rpx; border-radius: 16rpx; }
.set-item.active { background: var(--soft); }
.set-item.hide { display: none; }
.set-icon { width: 64rpx; height: 44rpx; border-radius: 8rpx; background: var(--imgbg); flex-shrink: 0; }
.si-name { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.si-title { font-size: 26rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.si-code { font-size: 20rpx; color: var(--txt2); }
.si-count { font-size: 20rpx; color: var(--txt2); background: var(--soft); padding: 4rpx 12rpx; border-radius: 20rpx; }

/* 当前弹 */
.hero { margin-top: 20rpx; padding: 26rpx 28rpx; }
.hero-line1 { display: flex; align-items: baseline; justify-content: space-between; }
.hero-name { font-size: 32rpx; font-weight: 800; }
.hero-count { font-size: 22rpx; color: var(--txt2); }
.hero-specs { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.hero-tag { font-size: 20rpx; color: var(--txt2); background: var(--soft); border: 1rpx solid var(--line); padding: 4rpx 14rpx; border-radius: 20rpx; }
.hero-tag.none { color: #f6a5c0; }

/* 规格按钮 */
.spec-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-top: 20rpx; }
.kind-single { background: linear-gradient(135deg, #2b4a8a, #1d3a6e); }
.kind-fat { background: linear-gradient(135deg, #6e3a1d, #8a2b2b); }
.kind-pack { background: linear-gradient(135deg, #6e1d64, #47207a); }
.kind-gem { background: linear-gradient(135deg, #1d6e5a, #207a63); }
.kind-reward { background: linear-gradient(135deg, #b3862c, #8a6a1d); }
.kind-ten { background: linear-gradient(135deg, #b33a2b, #7a1d20); }
.kind-box { background: linear-gradient(135deg, #2c6f4a, #1d5a63); }
.kind-ghost { background: var(--soft); border: 1rpx solid var(--line); color: var(--txt); }

/* 统计 */
.stats-row { display: flex; margin-top: 20rpx; padding: 22rpx 8rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.stat-b { font-size: 34rpx; font-weight: 800; color: var(--accent); }
.stat-s { font-size: 20rpx; color: var(--txt2); }

/* 记录 */
.rec-head { margin: 28rpx 4rpx 16rpx; }
.record { padding: 20rpx 24rpx; margin-bottom: 16rpx; }
.rec-line { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14rpx; gap: 12rpx; }
.rec-title { font-size: 25rpx; font-weight: 700; }
.rec-meta { font-size: 20rpx; color: var(--txt2); flex-shrink: 0; }
.rec-cards { white-space: nowrap; }
.mini-card { display: inline-flex; flex-direction: column; width: 140rpx; margin-right: 14rpx; }
.mini-card image { width: 140rpx; height: 196rpx; border-radius: 10rpx; background: var(--imgbg); }
.mc-name { font-size: 19rpx; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mc-rar { font-size: 18rpx; color: var(--txt2); }

/* 开包遮罩 */
.draw-mask { position: fixed; inset: 0; z-index: 80; background: rgba(5, 8, 16, .97); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.page.light .draw-mask { background: rgba(238, 241, 248, .98); }
.pack-stage { display: flex; flex-direction: column; align-items: center; gap: 30rpx; }
.pack { width: 420rpx; height: 580rpx; border-radius: 24rpx; position: relative; overflow: hidden;
  background: linear-gradient(150deg, #22335e, #14203c 60%, #0e1730);
  border: 2rpx solid rgba(255, 255, 255, .12); box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, .6);
  animation: packIn .5s ease; }
.pack-top { position: absolute; top: 0; left: 0; right: 0; height: 120rpx;
  background: repeating-linear-gradient(45deg, rgba(255, 255, 255, .10) 0 14rpx, transparent 14rpx 28rpx);
  border-bottom: 2rpx dashed rgba(255, 255, 255, .25); }
.pack-art { position: absolute; top: 50%; left: 50%; width: 200rpx; height: 200rpx; margin: -100rpx 0 0 -100rpx;
  border-radius: 50%; background: conic-gradient(#e3350d 0 25%, #f5f6f8 0 50%, #e3350d 0 75%, #f5f6f8 0);
  border: 10rpx solid #20242c; animation: spin 6s linear infinite; }
.pack-label { position: absolute; bottom: 30rpx; left: 0; right: 0; text-align: center; color: #cfd6e0; font-size: 24rpx; padding: 0 20rpx; }
.pack-hint { color: #9aa7bd; font-size: 26rpx; }
@keyframes packIn { from { transform: translateY(60rpx) scale(.9); opacity: 0; } to { transform: none; opacity: 1; } }
@keyframes spin { to { transform: rotate(360deg); } }

/* 翻卡 */
.cards-stage { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; padding: 30rpx 20rpx; box-sizing: border-box; }
.pack-nav { display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; }
.nav-btn { color: #ffce4a; font-size: 26rpx; padding: 10rpx 16rpx; }
.nav-btn.disabled { color: #55607a; }
.nav-info { color: #c3cbda; font-size: 24rpx; }
.cards-row { flex: 1; display: flex; flex-wrap: wrap; align-content: center; justify-content: center; gap: 18rpx; overflow-y: auto; }
.gcard { width: 190rpx; height: 266rpx; perspective: 900rpx; animation: deal .4s ease backwards; }
@keyframes deal { from { transform: translateY(50rpx); opacity: 0; } to { transform: none; opacity: 1; } }
.gcard-inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform .5s cubic-bezier(.2, .7, .3, 1.1); }
.gcard.flipped .gcard-inner { transform: rotateY(180deg); }
.gface { position: absolute; inset: 0; border-radius: 14rpx; backface-visibility: hidden; overflow: hidden; }
.gface.back { background: linear-gradient(150deg, #2a3c6e, #16223f 60%, #0f1830); border: 2rpx solid rgba(255, 255, 255, .14); }
.gface.front { transform: rotateY(180deg); background: #1a2233; }
.gface.front image { width: 100%; height: 100%; }
.stage-actions { display: flex; gap: 18rpx; margin-top: 26rpx; }

/* 概率/期望弹窗 */
.close-x { color: var(--txt2); padding: 0 10rpx; }
.prob-spec { margin-bottom: 26rpx; }
.prob-spec-title { color: var(--accent); font-size: 27rpx; margin-bottom: 8rpx; }
.prob-note { color: var(--txt2); font-size: 21rpx; line-height: 1.6; }
.prob-variant { margin-top: 14rpx; }
.prob-variant-note { color: var(--txt2); font-size: 22rpx; margin-bottom: 8rpx; }
.prob-slot { background: var(--soft); border-radius: 14rpx; padding: 14rpx 18rpx; margin-bottom: 12rpx; }
.slot-name { font-size: 24rpx; font-weight: 700; }
.slot-kind { color: var(--txt2); font-size: 19rpx; font-weight: 400; margin-left: 8rpx; }
.prob-line { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.pl-r { width: 64rpx; font-size: 21rpx; font-weight: 800; }
.pl-bar { flex: 1; height: 10rpx; border-radius: 10rpx; background: rgba(127, 127, 127, .18); overflow: hidden; }
.pl-fill { height: 100%; border-radius: 10rpx; }
.pl-p { font-size: 19rpx; color: var(--txt2); flex-shrink: 0; }
.expect-table { margin: 10rpx 0 6rpx; }
.et-row { display: flex; padding: 12rpx 6rpx; border-bottom: 1rpx solid var(--line); font-size: 23rpx; }
.et-row text { flex: 1; }
.et-row text:first-child { flex: 0.8; }
.et-head { color: var(--txt2); font-size: 20rpx; }

/* v1.2.2：规格选中态 */
.spec-active { outline: 3rpx solid var(--accent); outline-offset: 3rpx; }

/* 整盒/十连汇总条 */
.box-summary { width: 100%; background: rgba(255,255,255,.06); border: 1rpx solid rgba(255,255,255,.09); border-radius: 16rpx; padding: 16rpx 22rpx; margin-bottom: 18rpx; }
.box-head { display: flex; align-items: baseline; gap: 16rpx; flex-wrap: wrap; }
.box-title { color: #ffce4a; font-size: 28rpx; font-weight: 800; }
.box-meta { color: #9aa7bd; font-size: 22rpx; }
.box-chips { margin-top: 8rpx; display: flex; flex-wrap: wrap; gap: 6rpx 18rpx; font-size: 23rpx; font-weight: 700; }

/* 包号横滑页签 */
.pack-tabs { display: flex; max-width: 92vw; margin: 0 0 18rpx; white-space: nowrap; }
.pack-tab { display: inline-block; min-width: 56rpx; text-align: center; padding: 8rpx 14rpx; margin: 0 6rpx; border-radius: 12rpx; background: rgba(255,255,255,.07); color: #9aa7bd; font-size: 22rpx; }
.pack-tab.active { background: #ffce4a; color: #10141f; font-weight: 800; }

/* 高稀有度光效：翻开后按稀有度发光 + 高光扫过 */
.gcard.flipped .gface.front { transition: box-shadow .4s ease; }
.gcard.flipped.rc-RR .gface.front { box-shadow: 0 0 24rpx rgba(255, 215, 94, .8); }
.gcard.flipped.rc-AR .gface.front, .gcard.flipped.rc-SSR .gface.front, .gcard.flipped.rc-CHR .gface.front, .gcard.flipped.rc-CSR .gface.front { box-shadow: 0 0 26rpx rgba(126, 232, 250, .85); }
.gcard.flipped.rc-SR .gface.front { box-shadow: 0 0 28rpx rgba(255, 126, 219, .85); }
.gcard.flipped.rc-SAR .gface.front, .gcard.flipped.rc-HR .gface.front { box-shadow: 0 0 30rpx rgba(178, 141, 255, .9); }
.gcard.flipped.rc-UR .gface.front, .gcard.flipped.rc-FUR .gface.front, .gcard.flipped.rc-RGB .gface.front { box-shadow: 0 0 32rpx rgba(255, 200, 46, .95); }
.gcard.flipped.rc-sp .gface.front { box-shadow: 0 0 26rpx rgba(255, 95, 158, .8); }
.gcard.flipped.rc-RR .gface.front::after, .gcard.flipped.rc-AR .gface.front::after, .gcard.flipped.rc-SR .gface.front::after,
.gcard.flipped.rc-SAR .gface.front::after, .gcard.flipped.rc-UR .gface.front::after, .gcard.flipped.rc-ACE .gface.front::after,
.gcard.flipped.rc-HR .gface.front::after, .gcard.flipped.rc-RRR .gface.front::after, .gcard.flipped.rc-FUR .gface.front::after,
.gcard.flipped.rc-sp .gface.front::after {
  content: ""; position: absolute; inset: 0; border-radius: 14rpx; pointer-events: none;
  background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,.5) 48%, transparent 62%);
  transform: translateX(-120%); animation: shine 1s ease .1s 1 forwards;
}
@keyframes shine { to { transform: translateX(120%); } }

/* 自动翻卡开关 */
.rec-head { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 4rpx 16rpx; }
.autoflip { display: flex; align-items: center; gap: 8rpx; transform: scale(.8); transform-origin: right center; }
.autoflip-label { font-size: 22rpx; color: #9aa7bd; }

/* 稀有度出货分布 */
.dist-card { margin-top: 18rpx; padding: 22rpx 26rpx; display: flex; flex-direction: column; gap: 10rpx; }
.dist-title { font-size: 23rpx; color: #9aa7bd; font-weight: 700; letter-spacing: 2rpx; }
.dist-row { display: flex; align-items: center; gap: 14rpx; }
.dist-r { width: 72rpx; font-size: 21rpx; font-weight: 800; text-align: right; }
.dist-bar { flex: 1; height: 16rpx; border-radius: 12rpx; background: rgba(255,255,255,.08); overflow: hidden; }
.dist-fill { height: 100%; border-radius: 12rpx; min-width: 4rpx; }
.dist-n { width: 60rpx; font-size: 21rpx; color: #9aa7bd; }

/* 弹图标占位 */
.set-icon-fallback { display: flex; align-items: center; justify-content: center; font-size: 30rpx; }

/* ========== v1.2.3 ========== */
/* 规格分行按钮：行标签 + 单包/十连/整盒 */
.spec-rows { display: flex; flex-direction: column; gap: 14rpx; margin-top: 20rpx; }
.spec-row { display: flex; gap: 12rpx; align-items: stretch; }
.spec-row-label { width: 120rpx; display: flex; align-items: center; justify-content: flex-end;
  padding-right: 6rpx; font-size: 24rpx; font-weight: 800; color: var(--txt2); flex-shrink: 0; }
.spec-row .btn { flex: 1; padding: 18rpx 8rpx; min-width: 0; }
.spec-row.ghost .btn { padding: 14rpx 8rpx; }
.spec-active { outline: 3rpx solid #ffce4a; outline-offset: 3rpx; }

/* 汇总条：不透明底 */
.box-summary { background: #17203a; border: 1rpx solid rgba(255,255,255,.1); }
.page.light .box-summary { background: #ffffff; }

/* 页码严格单行 + 前后键等高 */
.pack-nav, .box-summary, .stage-actions { align-self: stretch; margin-left: 20rpx; margin-right: 20rpx; }
.pack-nav { justify-content: center; }
.pack-tabs { display: flex; flex-wrap: nowrap; justify-content: center; align-items: center; max-width: none; margin: 0; }
.pack-tab { display: inline-flex; align-items: center; justify-content: center; min-width: 56rpx; height: 56rpx;
  padding: 0 8rpx; margin: 0 6rpx; font-size: 22rpx; }
.pack-tab.ell { background: transparent; border: 0; color: #9aa7bd; font-weight: 400; min-width: 30rpx; padding: 0; }
.nav-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 56rpx; height: 56rpx;
  padding: 0; font-size: 30rpx; }

/* 光效增强：双层阴影 + 全高稀有度覆盖 */
.gcard.flipped.rc-RR .gface.front { box-shadow: 0 0 26rpx 4rpx rgba(255,215,94,.9), 0 0 70rpx 14rpx rgba(255,215,94,.45); }
.gcard.flipped.rc-AR .gface.front, .gcard.flipped.rc-SSR .gface.front, .gcard.flipped.rc-CHR .gface.front, .gcard.flipped.rc-CSR .gface.front { box-shadow: 0 0 26rpx 4rpx rgba(126,232,250,.9), 0 0 70rpx 14rpx rgba(126,232,250,.45); }
.gcard.flipped.rc-SR .gface.front { box-shadow: 0 0 26rpx 4rpx rgba(255,126,219,.92), 0 0 70rpx 14rpx rgba(255,126,219,.45); }
.gcard.flipped.rc-SAR .gface.front, .gcard.flipped.rc-HR .gface.front { box-shadow: 0 0 28rpx 5rpx rgba(178,141,255,.95), 0 0 74rpx 16rpx rgba(178,141,255,.5); }
.gcard.flipped.rc-UR .gface.front { box-shadow: 0 0 30rpx 5rpx rgba(255,200,46,.95), 0 0 80rpx 18rpx rgba(255,200,46,.5); }
.gcard.flipped.rc-ACE .gface.front { box-shadow: 0 0 26rpx 4rpx rgba(143,123,255,.9), 0 0 70rpx 14rpx rgba(143,123,255,.45); }
.gcard.flipped.rc-RRR .gface.front { box-shadow: 0 0 26rpx 4rpx rgba(255,169,77,.9), 0 0 70rpx 14rpx rgba(255,169,77,.45); }
.gcard.flipped.rc-FUR .gface.front { box-shadow: 0 0 30rpx 5rpx rgba(255,95,158,.95), 0 0 80rpx 18rpx rgba(255,95,158,.5); }
.gcard.flipped.rc-RGB .gface.front { box-shadow: 0 0 30rpx 5rpx rgba(224,195,252,.95), 0 0 80rpx 18rpx rgba(224,195,252,.5); }
.gcard.flipped.rc-sp .gface.front { box-shadow: 0 0 28rpx 4rpx rgba(255,95,158,.9), 0 0 70rpx 14rpx rgba(255,95,158,.45); }

/* ========== v1.2.3(二轮)：下拉手风琴 ========== */
.spec-acc { display: flex; flex-direction: column; gap: 14rpx; margin-top: 20rpx; }
.acc-item { display: flex; flex-direction: column; }
.pack-toggle { flex-direction: row; align-items: center; justify-content: space-between; gap: 16rpx;
  text-align: left; padding: 20rpx 24rpx; }
.pt-left { display: flex; flex-direction: column; align-items: flex-start; gap: 4rpx; min-width: 0; flex: 1; }
.pt-left .btn-sub { letter-spacing: 0; }
.pt-caret { font-size: 26rpx; opacity: .9; flex-shrink: 0; }
.spec-drop { display: flex; flex-direction: column; gap: 12rpx; margin-top: 12rpx; }
.spec-drop .btn { padding: 20rpx 8rpx; }
.spec-acc > .btn-ghost { padding: 18rpx 8rpx; }

/* 页码两行式：页码行 + 前后包行 */
.pack-nav { flex-direction: column; gap: 14rpx; }
.pack-tabs { width: 100%; justify-content: space-between; }
.pack-switch { display: flex; gap: 14rpx; width: 100%; }
.pack-switch .nav-btn { flex: 1; height: 68rpx; background: rgba(255,255,255,.08); border-radius: 14rpx;
  font-size: 25rpx; }
.page.light .pack-switch .nav-btn { background: rgba(16,24,48,.08); }

.page { padding: 20rpx 24rpx 0; }
.head-tools { display: flex; align-items: center; gap: 12rpx; }
.set-pick { max-width: 340rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tools-row { display: flex; align-items: center; gap: 20rpx; margin: 4rpx 0 18rpx; }
.switch { font-size: 24rpx; color: var(--txt2); }
.switch.danger { color: #f6a5c0; }
.switch-label { font-size: 24rpx; color: var(--txt2); }
.summary { padding: 20rpx 24rpx; font-size: 24rpx; color: var(--txt); }
.progress { display: flex; align-items: center; gap: 16rpx; margin: 18rpx 0; }
.progress-bar { flex: 1; height: 12rpx; border-radius: 20rpx; background: var(--soft); overflow: hidden; }
.progress-fill { height: 100%; border-radius: 20rpx; background: linear-gradient(90deg, #4aa8ff, #ffd75e, #ffc82e); transition: width .4s ease; }
.progress-text { font-size: 21rpx; color: var(--txt2); white-space: nowrap; }

.coll-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 18rpx; }
.coll-card { position: relative; border-radius: 16rpx; overflow: hidden; background: var(--card-bg); border: 1rpx solid var(--line); }
.coll-card image { width: 100%; height: 320rpx; display: block; background: var(--imgbg); }
.coll-card.missing image { filter: grayscale(.9) brightness(.55); }
.cc-x { position: absolute; top: 10rpx; right: 10rpx; background: var(--accent); color: #10141f; font-size: 20rpx; font-weight: 800; border-radius: 10rpx; padding: 2rpx 12rpx; }
.coll-card.missing .cc-x { background: var(--red); color: #fff; }
.cc-name { display: flex; align-items: center; padding: 10rpx 12rpx; gap: 4rpx; }
.cc-n { font-size: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
